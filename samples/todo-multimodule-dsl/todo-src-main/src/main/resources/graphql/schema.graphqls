extend type Query {
  authors: [Author!]!
  books(filter: BookFilter): [Book!]!
}

extend type Mutation {
  createAuthor(input: AuthorInput!): Author!
  createBook(input: BookInput!): Book!
}

input AuthorInput {
  name: String!
}

input BookInput {
  title: String!
  authorId: Int!
}

input BookFilter {
  titleContains: String
  authorNameContains: String
}
